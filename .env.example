DISCORD_TOKEN=put-your-discord-bot-token-here
# Optional Webshare proxy credentials. Leave blank to use direct requests.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Optional comma-separated Webshare proxy hosts in host:port form.
WEBSHARE_PROXY_HOSTS=
# Optional: an authorized yt-dlp Netscape-format cookie file for Instagram Stories/login-gated media.
# Keep this file private and never commit it.
YT_DLP_COOKIES_FILE=/absolute/path/to/instagram-cookies.txt
